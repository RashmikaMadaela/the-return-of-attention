# Application URLs
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-secret

# Database
DATABASE_URL=postgresql://postgres:password@db.example.supabase.co:5432/postgres?sslmode=require
DIRECT_URL=postgresql://postgres:password@db.example.supabase.co:5432/postgres?sslmode=require

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-supabase-service-role-key

# Email and verification
ENABLE_EMAIL_VERIFICATION=false
RESEND_API_KEY=
FROM_EMAIL=no-reply@example.com

# Optional Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Admin bootstrap and protected admin operations
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ADMIN_NAME=Project Administrator
ADMIN_REGISTRATION_KEY=replace-with-a-private-admin-registration-key
ADMIN_CLEAR_DATA_CODE=replace-with-a-private-clear-data-code